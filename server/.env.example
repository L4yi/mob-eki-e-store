# ==========================================
# M.O.B EKI VENTURES - Backend Environment Variables
# Stack: Vercel (Backend API) + Supabase (Database) + Firebase (Frontend)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (64-character random string)
JWT_SECRET=mob_eki_jwt_secret_key_production_2026_replace_in_production

# Frontend URL (For CORS whitelist)
FRONTEND_URL=https://mob-eki-ventures.web.app

# ------------------------------------------
# Supabase Database Configuration (PostgreSQL)
# Obtain from Supabase Dashboard -> Project Settings -> API
# ------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Optional Anon Key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------
# Paystack Payment Gateway
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks
# ------------------------------------------
# Test: sk_test_... | Live: sk_live_...
PAYSTACK_SECRET_KEY=sk_test_placeholder_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_public_key

# ------------------------------------------
# Initial Super Admin Seed Credentials
# ------------------------------------------
ADMIN_EMAIL=admin@mobekiventures.com
ADMIN_PASSWORD=adminpassword123
ADMIN_PHONE=08108725967

# ------------------------------------------
# Business & Showroom Info
# ------------------------------------------
BUSINESS_NAME="M.O.B EKI VENTURES"
SHOWROOM_ADDRESS="2, Amu Street, Mushin Market, Lagos, Nigeria"
WHATSAPP_NUMBER=2348108725967
