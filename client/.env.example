# ==========================================
# M.O.B EKI VENTURES - Frontend Environment Variables
# ==========================================

# Backend API URL (Omit in local dev if using Vite proxy, or set to your deployed backend URL in production)
# Example for production: https://api.mobekiventures.com or https://mob-eki-backend.onrender.com
VITE_API_URL=

# Paystack Public Key (Optional if initializing inline JS popup directly on frontend)
# Test: pk_test_... | Live: pk_live_...
VITE_PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key

# Support WhatsApp Number (for deep links)
VITE_WHATSAPP_NUMBER=2348108725967
